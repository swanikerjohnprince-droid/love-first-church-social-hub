APP_NAME=LFC Social Hub API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lfc:lfc_dev_password@localhost:5432/lfc_social_hub
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173
# Generate long random values for deployment. Never commit your real .env file.
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
BOOTSTRAP_SECRET=replace-with-a-separate-one-time-owner-setup-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Frontend API URL. Leave blank for the static demo preview; set to the deployed API origin when available.
# VITE_API_BASE_URL=https://api.example.com
